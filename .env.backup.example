# Copie este arquivo para .env.backup e preencha com suas credenciais do Railway

# 1. Abra: https://railway.app/project/[seu-projeto]
# 2. Clique em "PostgreSQL"
# 3. Copie a URL de conexão de "Database URL" ou "Connection string"
# 4. Cole aqui:

DATABASE_URL=postgresql://user:password@host:5432/dbname
